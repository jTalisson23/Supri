<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9DA60"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:id="@+id/imagePedidoConfirmado"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:contentDescription="Imagem de confirmação"
        android:src="@drawable/pedido_confirmado" />

    <TextView
        android:id="@+id/numeroPedidoTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Pedido confirmado!"
        android:textColor="#333"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Estamos cuidando do seu pedido agora.\nPor favor, aguarde!"
        android:textColor="#555"
        android:textSize="16sp" />

    <!-- Botão de ACOMPANHAR PEDIDO -->
    <Button
        android:id="@+id/buttonRegister"
        style="@style/BotaoVermelho"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="ACOMPANHAR PEDIDO" />
</LinearLayout>
